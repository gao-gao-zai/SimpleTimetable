<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/card_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/app_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="11sp" />
            <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/course_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/course_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_courses" android:textSize="24sp" android:textStyle="bold" android:maxLines="3" />
                <TextView android:id="@+id/course_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/countdown_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp">
                <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:accessibilityLiveRegion="none" />
                <TextView android:id="@+id/countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/progress_image" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:scaleType="fitXY" android:importantForAccessibility="yes" android:contentDescription="@string/progress_description" />
        <TextView android:id="@+id/progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="11sp" />
        <FrameLayout android:id="@+id/next_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <ImageView android:id="@+id/next_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tonal_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <TextView android:id="@+id/next_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="26dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" />
        </FrameLayout>
        <TextView android:id="@+id/open_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="end|center_vertical" android:layout_marginTop="3dp" android:text="@string/open_today" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
