<template>
  <div class="card">
    <text class="caption">课程卡预览</text>
    <text class="course">{{title}}</text>
    <text class="next">下一节 · {{next}}</text>
    <text class="status" onclick="refresh">{{status}} · 点击刷新</text>
  </div>
</template>
<script>
import { SnapshotReader } from '../../platform/snapshot-reader.js'
const readers = new WeakMap()
export default {
  data:{title:'请打开简单课表',next:'',status:'等待 App 发布'},
  onReady(){const reader=new SnapshotReader(v=>{this.title=v.title;this.next=v.next;this.status=v.expired?'已过期，打开 App 更新':'版本 '+v.version});readers.set(this,reader);reader.start()},
  onShow(){const reader=readers.get(this);if(reader){reader.start();reader.refresh()}},
  onHide(){const reader=readers.get(this);if(reader)reader.stop()},
  refresh(){const reader=readers.get(this);if(reader)reader.refresh()},
  onDestroy(){const reader=readers.get(this);if(reader)reader.stop();readers.delete(this)}
}
</script>
<style>
.card{width:100%;height:100%;background-color:#101E16;flex-direction:column;padding:24px;justify-content:center;}
.caption{color:#54C589;font-size:22px;}
.course{color:#F1F7F3;font-size:32px;margin:12px 0;}
.next{color:#E1EDE4;font-size:24px;}
.status{color:#B3C6BA;font-size:18px;margin-top:8px;}
</style>
