<template>
  <div class="card">
    <text class="caption">简单课表</text>
    <text class="course">{{title}}</text>
    <text class="next">下一节 · {{next}}</text>
    <text class="status">{{status}}</text>
  </div>
</template>
<script>
import { SnapshotReader } from './lib/snapshot-reader.js'
let reader=null
export default {
  data:{title:'请打开简单课表',next:'',status:'等待 App 发布'},
  onReady(){reader=new SnapshotReader(v=>{this.title=v.title;this.next=v.next;this.status=v.expired?'已过期，打开 App 更新':'版本 '+v.version});reader.start()},
  onShow(){if(reader)reader.refresh()},
  onDestroy(){if(reader)reader.stop();reader=null}
}
</script>
<style>
.card{width:100%;height:100%;background-color:#101E16;flex-direction:column;padding:24px;justify-content:center;}
.caption{color:#54C589;font-size:22px;}
.course{color:#F1F7F3;font-size:32px;margin:12px 0;}
.next{color:#E1EDE4;font-size:24px;}
.status{color:#B3C6BA;font-size:18px;margin-top:8px;}
</style>
